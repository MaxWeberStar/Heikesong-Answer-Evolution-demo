# ===== 答案演进论 环境变量示例 =====
# 复制为 .env.local 并按需填写。所有变量仅在服务端使用，不下发浏览器。

# 知乎 CLI 绝对路径（Officev3 会注入 ZHIHU_CLI_HOME；开发机可直接指向二进制）
ZHIHU_CLI=/Applications/看山工作台.app/Contents/Resources/cli-bundle/zhihu/current/zhihu-cli

# LLM（答案画像 / 溯源 / 分类命名）—— OpenAI 兼容接口
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embedding（P1 聚类用；留空则降级为 LLM 直接归类）
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# SQLite 数据文件（缓存 + 我的清单）
SQLITE_PATH=./data/app.db

# ===== 知乎 OAuth 登录（黑客松，评分项）=====
# App ID / App Key 由赛事页面分配（见 skill: hackathon-oauth.md）。
# 未填写时自动进入 Mock 模式，可演示登录闭环但不访问真网。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# 回调地址必须与赛事页面登记值完全一致（协议/域名/端口/路径/尾斜杠）
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
# 读取授权用户创作/关注/收藏时还需 Access Secret（仅基础登录可不填）
ZHIHU_ACCESS_SECRET=
# 应用对外基址（用于 OAuth 重定向回跳；线上填公网 HTTPS 域名）
APP_BASE_URL=http://localhost:3000
# 强制 Mock 模式（本地演示登录闭环）：设为 1
ZHIHU_OAUTH_MOCK=
